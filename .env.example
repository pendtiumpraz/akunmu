# --- Database (PostgreSQL / Neon) ---
# Pooled connection used at runtime.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct connection used by migrations (npm run db:migrate, vercel-build).
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
# Optional: connections per server instance (default 1 on Vercel, 5 elsewhere).
# DATABASE_POOL_MAX=5

# --- Application ---
# Random string of at least 32 characters. Encrypts stored AI keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Default language: any code registered in src/shared/i18n/locales.ts (id, en).
DEFAULT_LOCALE=id

# --- Storage (Vercel Blob) ---
# Not used yet; kept for features that will store files.
BLOB_READ_WRITE_TOKEN=
