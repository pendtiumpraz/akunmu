{
  "name": "akunmu",
  "version": "0.1.0",
  "private": true,
  "description": "Where every account is signed in: devices, browser profiles and the accounts on them, with an AI assistant",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run extension:pack",
    "dev": "next dev",
    "prebuild": "npm run extension:pack",
    "build": "next build",
    "start": "next start",
    "vercel-build": "npm run db:migrate && npm run extension:pack && next build",
    "extension:pack": "node extension/scripts/pack.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env --import tsx scripts/create-user.ts",
    "platform:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
